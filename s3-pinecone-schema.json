{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "wso2": {
      "type": "object",
      "properties": {
        "rag_ingestion": {
          "type": "object",
          "title": "Amazon S3 to Pinecone Configuration",
          "properties": {
            "s3AccessKeyId": {
              "type": "string",
              "format": "password",
              "title": "S3 Access Key ID"
            },
            "s3SecretKey": {
              "type": "string",
              "format": "password",
              "title": "S3 Secret Access Key"
            },
            "s3BucketName": {
              "type": "string",
              "title": "S3 Bucket Name"
            },
            "pineconeApiKey": {
              "type": "string",
              "format": "password",
              "title": "Pinecone API Key"
            },
            "pineconeIndex": {
              "type": "string",
              "title": "Pinecone Index Name"
            },
            "embeddingProvider": {
              "type": "string",
              "title": "Embedding Provider",
              "enum": ["openai", "azure"],
              "default": "openai"
            },
            "embeddingModel": {
              "type": "string",
              "title": "Embedding Model"
            },
            "embeddingApiKey": {
              "type": "string",
              "format": "password",
              "title": "Embedding API Key"
            },
            "azureBaseUrl": {
              "type": "string",
              "title": "Azure Base URL"
            },
            "azureApiVersion": {
              "type": "string",
              "title": "Azure API Version"
            },
            "chunkingStrategy": {
              "type": "string",
              "enum": ["recursive", "sentence", "character"],
              "default": "recursive",
              "title": "Chunking Strategy"
            },
            "maxSegmentSize": {
              "type": "integer",
              "default": 500,
              "minimum": 1,
              "title": "Max Segment Size"
            },
            "maxOverlapSize": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "title": "Max Overlap Size"
            }
          },
          "required": ["s3AccessKeyId", "s3SecretKey", "s3BucketName", "pineconeApiKey", "pineconeIndex", "embeddingProvider", "embeddingModel", "embeddingApiKey"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
