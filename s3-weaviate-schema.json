{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Amazon S3 to Weaviate Configuration",
  "properties": {
    "s3AccessKeyId": {
      "type": "string",
      "format": "password",
      "title": "S3 Access Key ID"
    },
    "s3SecretKey": {
      "type": "string",
      "format": "password",
      "title": "S3 Secret Access Key"
    },
    "s3BucketName": {
      "type": "string",
      "title": "S3 Bucket Name"
    },
    "clientId": {
      "type": "string",
      "title": "Client ID"
    },
    "clientSecret": {
      "type": "string",
      "format": "password",
      "title": "Client Secret"
    },
    "refreshToken": {
      "type": "string",
      "format": "password",
      "title": "Refresh Token"
    },
    "weaviateUrl": {
      "type": "string",
      "title": "Weaviate Cluster URL"
    },
    "weaviateApiKey": {
      "type": "string",
      "format": "password",
      "title": "Weaviate API Key"
    },
    "weaviateCollection": {
      "type": "string",
      "title": "Weaviate Collection Name"
    },
    "embeddingProvider": {
      "type": "string",
      "title": "Embedding Provider",
      "enum": ["openai", "azure-openai", "mistral"]
    },
    "embeddingModel": {
      "type": "string",
      "title": "Embedding Model"
    },
    "embeddingApiKey": {
      "type": "string",
      "format": "password",
      "title": "Embedding API Key",
      "description": "API key for OpenAI, Azure OpenAI, or Mistral (depending on provider selected)"
    },
    "azureBaseUrl": {
      "type": "string",
      "title": "Azure Base URL",
      "description": "Required if using Azure OpenAI. Format: https://resource-name.openai.azure.com/openai"
    },
    "azureApiVersion": {
      "type": "string",
      "title": "Azure API Version",
      "default": "2024-06-01",
      "description": "Required if using Azure OpenAI. Example: 2024-06-01"
    },
    "chunkingStrategy": {
      "type": "string",
      "enum": ["recursive", "sentence", "character"],
      "title": "Chunking Strategy"
    },
    "maxSegmentSize": {
      "type": "integer",
      "minimum": 1,
      "default": 1000,
      "title": "Max Segment Size (characters)"
    },
    "maxOverlapSize": {
      "type": "integer",
      "minimum": 0,
      "default": 200,
      "title": "Max Overlap Size (characters)"
    }
  },
  "required": ["s3AccessKeyId", "s3SecretKey", "s3BucketName", "weaviateUrl", "weaviateApiKey", "weaviateCollection", "embeddingProvider", "embeddingModel", "embeddingApiKey", "chunkingStrategy", "maxSegmentSize", "maxOverlapSize"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "embeddingProvider": {
            "const": "openai"
          }
        },
        "required": ["embeddingProvider"]
      },
      "then": {
        "properties": {
          "embeddingModel": {
            "enum": ["text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "embeddingProvider": {
            "const": "azure-openai"
          }
        },
        "required": ["embeddingProvider"]
      },
      "then": {
        "properties": {
          "embeddingModel": {
            "enum": ["text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"]
          }
        },
        "required": ["embeddingProvider", "embeddingModel", "embeddingApiKey", "azureBaseUrl", "azureApiVersion"]
      }
    },
    {
      "if": {
        "properties": {
          "embeddingProvider": {
            "const": "mistral"
          }
        },
        "required": ["embeddingProvider"]
      },
      "then": {
        "properties": {
          "embeddingModel": {
            "enum": ["mistral-embed"]
          }
        }
      }
    }
  ]
}
