{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Google Drive to Pinecone Configuration",
  "required": [
    "googledriveconfig",
    "pineconeconfig",
    "embeddingconfig",
    "chunkingconfig"
  ],
  "additionalProperties": false,
  "properties": {
    "googledriveconfig": {
      "type": "object",
      "title": "Google Drive Configuration",
      "properties": {
        "gdriveAuthType": {
          "type": "string",
          "title": "Google Drive Auth Type",
          "enum": ["api_key", "oauth"],
          "description": "Select authentication type: API Key or OAuth."
        },
        "gdriveFolderId": {
          "type": "string",
          "title": "Google Drive Folder ID"
        },
        "gdriveApiKey": {
          "type": "string",
          "format": "password",
          "title": "Google Drive API Key"
        },
        "clientId": {
          "type": "string",
          "title": "Client ID (OAuth)"
        },
        "clientSecret": {
          "type": "string",
          "format": "password",
          "title": "Client Secret (OAuth)"
        },
        "refreshToken": {
          "type": "string",
          "format": "password",
          "title": "Refresh Token (OAuth)"
        }
      },
      "required": ["gdriveAuthType", "gdriveFolderId"],
      "dependencies": {
        "gdriveAuthType": {
          "oneOf": [
            {
              "properties": { "gdriveAuthType": { "const": "api_key" } },
              "required": ["gdriveApiKey"]
            },
            {
              "properties": { "gdriveAuthType": { "const": "oauth" } },
              "required": ["clientId", "clientSecret", "refreshToken"]
            }
          ]
        }
      }
    },
    "pineconeconfig": {
      "type": "object",
      "title": "Pinecone Configuration",
      "properties": {
        "pineconeApiKey": {
          "type": "string",
          "format": "password",
          "title": "Pinecone API Key"
        },
        "pineconeIndex": {
          "type": "string",
          "title": "Pinecone Index Name"
        }
      },
      "required": ["pineconeApiKey", "pineconeIndex"]
    },
    "embeddingconfig": {
      "type": "object",
      "title": "Embedding Configuration",
      "properties": {
        "embeddingProvider": {
          "type": "string",
          "title": "Embedding Provider",
          "enum": ["openai", "azure-openai", "mistral"]
        },
        "embeddingApiKey": {
          "type": "string",
          "format": "password",
          "title": "Embedding API Key",
          "description": "API key for OpenAI, Azure OpenAI, or Mistral"
        },
        "embeddingModel": {
          "type": "string",
          "title": "Embedding Model",
          "enum": [
            "text-embedding-3-small",
            "text-embedding-3-large",
            "text-embedding-ada-002",
            "mistral-embed"
          ]
        },
        "azureBaseUrl": {
          "type": "string",
          "title": "Azure Base URL",
          "description": "Format: https://resource-name.openai.azure.com/openai"
        },
        "azureApiVersion": {
          "type": "string",
          "title": "Azure API Version",
          "default": "2024-06-01",
          "description": "Example: 2024-06-01"
        }
      },
      "required": ["embeddingProvider", "embeddingApiKey"],
      "dependencies": {
        "embeddingProvider": {
          "oneOf": [
            {
              "properties": { "embeddingProvider": { "const": "openai" } },
              "required": ["embeddingModel"]
            },
            {
              "properties": { "embeddingProvider": { "const": "azure-openai" } },
              "required": ["embeddingModel", "azureBaseUrl", "azureApiVersion"]
            },
            {
              "properties": { "embeddingProvider": { "const": "mistral" } },
              "required": ["embeddingModel"]
            }
          ]
        }
      }
    },
    "chunkingconfig": {
      "type": "object",
      "title": "Chunking Configuration",
      "properties": {
        "chunkingStrategy": {
          "type": "string",
          "enum": ["recursive", "sentence", "character"],
          "title": "Chunking Strategy"
        },
        "maxSegmentSize": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "title": "Max Segment Size (characters)"
        },
        "maxOverlapSize": {
          "type": "integer",
          "minimum": 0,
          "default": 200,
          "title": "Max Overlap Size (characters)"
        }
      },
      "required": ["chunkingStrategy", "maxSegmentSize", "maxOverlapSize"]
    }
  },
   "requiredLevel": 2
}
