{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "wso2": {
      "type": "object",
      "properties": {
        "rag_ingestion": {
          "type": "object",
          "title": "Google Drive to Pinecone Configuration",
          "properties": {
            "gdriveApiKey": {
              "type": "string",
              "format": "password",
              "title": "Google Drive API Key",
              "description": "Your Google Drive API credentials"
            },
            "gdriveFolderId": {
              "type": "string",
              "title": "Google Drive Folder ID",
              "description": "The folder ID containing documents to ingest"
            },
            "pineconeApiKey": {
              "type": "string",
              "format": "password",
              "title": "Pinecone API Key",
              "description": "Your Pinecone API credentials"
            },
            "pineconeIndex": {
              "type": "string",
              "title": "Pinecone Index Name",
              "description": "Target index for storing embeddings"
            },
            "embeddingProvider": {
              "type": "string",
              "title": "Embedding Provider",
              "enum": ["openai", "azure"],
              "default": "openai"
            },
            "embeddingModel": {
              "type": "string",
              "title": "Embedding Model",
              "description": "e.g., text-embedding-3-small for OpenAI"
            },
            "embeddingApiKey": {
              "type": "string",
              "format": "password",
              "title": "Embedding API Key"
            },
            "azureBaseUrl": {
              "type": "string",
              "title": "Azure Base URL",
              "description": "Required only if using Azure as embedding provider"
            },
            "azureApiVersion": {
              "type": "string",
              "title": "Azure API Version",
              "description": "Required only if using Azure as embedding provider"
            },
            "chunkingStrategy": {
              "type": "string",
              "enum": ["recursive", "sentence", "character"],
              "default": "recursive",
              "title": "Chunking Strategy"
            },
            "maxSegmentSize": {
              "type": "integer",
              "default": 500,
              "minimum": 1,
              "title": "Max Segment Size"
            },
            "maxOverlapSize": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "title": "Max Overlap Size"
            }
          },
          "required": ["gdriveApiKey", "gdriveFolderId", "pineconeApiKey", "pineconeIndex", "embeddingProvider", "embeddingModel", "embeddingApiKey"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
