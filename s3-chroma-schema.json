{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "wso2": {
      "type": "object",
      "properties": {
        "rag_ingestion": {
          "type": "object",
          "title": "Amazon S3 to Chroma Configuration",
          "properties": {
            "datasource": {
              "type": "object",
              "title": "Data Source Configuration",
              "properties": {
                "s3AccessKeyId": {
                  "type": "string",
                  "format": "password",
                  "title": "S3 Access Key ID"
                },
                "s3SecretKey": {
                  "type": "string",
                  "format": "password",
                  "title": "S3 Secret Access Key"
                },
                "s3BucketName": {
                  "type": "string",
                  "title": "S3 Bucket Name"
                }
              },
              "required": ["s3AccessKeyId", "s3SecretKey", "s3BucketName"],
              "additionalProperties": false
            },
            "vectordb": {
              "type": "object",
              "title": "Vector Database Configuration",
              "properties": {
                "chromaHost": {
                  "type": "string",
                  "title": "Chroma Host"
                },
                "chromaPort": {
                  "type": "integer",
                  "title": "Chroma Port"
                },
                "chromaCollection": {
                  "type": "string",
                  "title": "Chroma Collection Name"
                }
              },
              "required": ["chromaHost", "chromaPort", "chromaCollection"],
              "additionalProperties": false
            },
            "embedding": {
              "type": "object",
              "title": "Embedding Configuration",
              "properties": {
                "embeddingProvider": {
                  "type": "string",
                  "title": "Embedding Provider",
                  "enum": ["openai", "azure-openai", "mistral"]
                },
                "embeddingModel": {
                  "type": "string",
                  "title": "Embedding Model",
                  "oneOf": [
                    {
                      "type": "string",
                      "title": "OpenAI Models",
                      "enum": ["text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"]
                    },
                    {
                      "type": "string",
                      "title": "Azure OpenAI Models",
                      "enum": ["text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"]
                    },
                    {
                      "type": "string",
                      "title": "Mistral Models",
                      "enum": ["mistral-embed"]
                    }
                  ]
                },
                "embeddingApiKey": {
                  "type": "string",
                  "format": "password",
                  "title": "Embedding API Key",
                  "description": "API key for OpenAI, Azure OpenAI, or Mistral (depending on provider selected)"
                },
                "azureBaseUrl": {
                  "type": "string",
                  "title": "Azure Base URL",
                  "description": "Required if using Azure OpenAI. Format: https://resource-name.openai.azure.com/openai"
                },
                "azureApiVersion": {
                  "type": "string",
                  "title": "Azure API Version",
                  "description": "Required if using Azure OpenAI. Example: 2024-06-01"
                }
              },
              "required": ["embeddingProvider", "embeddingModel", "embeddingApiKey", "azureBaseUrl", "azureApiVersion"],
              "additionalProperties": false
            },
            "chunking": {
              "type": "object",
              "title": "Document Chunking Configuration",
              "properties": {
                "chunkingStrategy": {
                  "type": "string",
                  "enum": ["recursive", "sentence", "character"],
                  "title": "Chunking Strategy"
                },
                "maxSegmentSize": {
                  "type": "integer",
                  "minimum": 1,
                  "title": "Max Segment Size (characters)"
                },
                "maxOverlapSize": {
                  "type": "integer",
                  "minimum": 0,
                  "title": "Max Overlap Size (characters)"
                }
              },
              "required": ["chunkingStrategy", "maxSegmentSize", "maxOverlapSize"],
              "additionalProperties": false
            }
          },
          "required": ["datasource", "vectordb", "embedding", "chunking"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
