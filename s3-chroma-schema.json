{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "wso2": {
      "type": "object",
      "properties": {
        "rag_ingestion": {
          "type": "object",
          "title": "Amazon S3 to Chroma Configuration",
          "properties": {
            "datasource": {
              "type": "object",
              "title": "Data Source Configuration",
              "properties": {
                "s3AccessKeyId": {
                  "type": "string",
                  "format": "password",
                  "title": "S3 Access Key ID"
                },
                "s3SecretKey": {
                  "type": "string",
                  "format": "password",
                  "title": "S3 Secret Access Key"
                },
                "s3BucketName": {
                  "type": "string",
                  "title": "S3 Bucket Name"
                }
              },
              "required": ["s3AccessKeyId", "s3SecretKey", "s3BucketName"],
              "additionalProperties": false
            },
            "vectordb": {
              "type": "object",
              "title": "Vector Database Configuration",
              "properties": {
                "chromaHost": {
                  "type": "string",
                  "title": "Chroma Host"
                },
                "chromaPort": {
                  "type": "integer",
                  "title": "Chroma Port"
                },
                "chromaCollection": {
                  "type": "string",
                  "title": "Chroma Collection Name"
                }
              },
              "required": ["chromaHost", "chromaPort", "chromaCollection"],
              "additionalProperties": false
            },
            "embedding": {
              "oneOf": [
                {
                  "type": "object",
                  "title": "Embedding Configuration - OpenAI",
                  "properties": {
                    "embeddingProvider": {
                      "const": "openai",
                      "type": "string",
                      "title": "Embedding Provider"
                    },
                    "embeddingModel": {
                      "type": "string",
                      "title": "Embedding Model",
                      "enum": ["text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"]
                    },
                    "embeddingApiKey": {
                      "type": "string",
                      "format": "password",
                      "title": "Embedding API Key",
                      "description": "OpenAI API key"
                    },
                    "azureBaseUrl": {
                      "type": "string",
                      "title": "Azure Base URL"
                    },
                    "azureApiVersion": {
                      "type": "string",
                      "title": "Azure API Version"
                    }
                  },
                  "required": ["embeddingProvider", "embeddingModel", "embeddingApiKey"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "title": "Embedding Configuration - Azure OpenAI",
                  "properties": {
                    "embeddingProvider": {
                      "const": "azure-openai",
                      "type": "string",
                      "title": "Embedding Provider"
                    },
                    "embeddingModel": {
                      "type": "string",
                      "title": "Embedding Model",
                      "enum": ["text-embedding-3-small", "text-embedding-3-large", "text-embedding-ada-002"]
                    },
                    "embeddingApiKey": {
                      "type": "string",
                      "format": "password",
                      "title": "Embedding API Key",
                      "description": "Azure OpenAI API key"
                    },
                    "azureBaseUrl": {
                      "type": "string",
                      "title": "Azure Base URL",
                      "description": "Format: https://resource-name.openai.azure.com/openai"
                    },
                    "azureApiVersion": {
                      "type": "string",
                      "title": "Azure API Version",
                      "default": "2024-06-01",
                      "description": "Example: 2024-06-01"
                    }
                  },
                  "required": ["embeddingProvider", "embeddingModel", "embeddingApiKey", "azureBaseUrl", "azureApiVersion"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "title": "Embedding Configuration - Mistral",
                  "properties": {
                    "embeddingProvider": {
                      "const": "mistral",
                      "type": "string",
                      "title": "Embedding Provider"
                    },
                    "embeddingModel": {
                      "type": "string",
                      "title": "Embedding Model",
                      "enum": ["mistral-embed"]
                    },
                    "embeddingApiKey": {
                      "type": "string",
                      "format": "password",
                      "title": "Embedding API Key",
                      "description": "Mistral API key"
                    },
                    "azureBaseUrl": {
                      "type": "string",
                      "title": "Azure Base URL"
                    },
                    "azureApiVersion": {
                      "type": "string",
                      "title": "Azure API Version"
                    }
                  },
                  "required": ["embeddingProvider", "embeddingModel", "embeddingApiKey"],
                  "additionalProperties": false
                }
              ],
              "discriminator": {
                "propertyName": "embeddingProvider"
              }
            },
            "chunking": {
              "type": "object",
              "title": "Document Chunking Configuration",
              "properties": {
                "chunkingStrategy": {
                  "type": "string",
                  "enum": ["recursive", "sentence", "character"],
                  "title": "Chunking Strategy"
                },
                "maxSegmentSize": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1000,
                  "title": "Max Segment Size (characters)"
                },
                "maxOverlapSize": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 200,
                  "title": "Max Overlap Size (characters)"
                }
              },
              "required": ["chunkingStrategy", "maxSegmentSize", "maxOverlapSize"],
              "additionalProperties": false
            }
          },
          "required": ["datasource", "vectordb", "embedding", "chunking"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
