{
  "type": "object",
  "packages": {
    "connection": {
      "type": "object",
      "title": "RAG Configuration",
      "required": ["datasource", "vectorDb", "embeddingProvider", "embeddingModel", "embeddingApiKey"],
      "properties": {
        "datasource": {
          "type": "string",
          "title": "Data Source",
          "enum": ["gdrive", "s3"],
          "description": "Select your data source"
        },
        "gdriveApiKey": {
          "type": "string",
          "format": "password",
          "title": "Google Drive API Key",
          "description": "API key for Google Drive access"
        },
        "gdriveFolderId": {
          "type": "string",
          "title": "Google Drive Folder ID",
          "description": "Folder ID containing your documents"
        },
        "s3AccessKeyId": {
          "type": "string",
          "format": "password",
          "title": "S3 Access Key ID"
        },
        "s3SecretKey": {
          "type": "string",
          "format": "password",
          "title": "S3 Secret Access Key"
        },
        "s3BucketName": {
          "type": "string",
          "title": "S3 Bucket Name"
        },
        "vectorDb": {
          "type": "string",
          "title": "Vector Database",
          "enum": ["pinecone", "weaviate", "postgresql", "chroma"],
          "description": "Select your vector database"
        },
        "pineconeApiKey": {
          "type": "string",
          "format": "password",
          "title": "Pinecone API Key"
        },
        "pineconeIndex": {
          "type": "string",
          "title": "Pinecone Index Name"
        },
        "weaviateUrl": {
          "type": "string",
          "title": "Weaviate Cluster URL",
          "format": "uri"
        },
        "weaviateApiKey": {
          "type": "string",
          "format": "password",
          "title": "Weaviate API Key"
        },
        "weaviateCollection": {
          "type": "string",
          "title": "Weaviate Collection Name"
        },
        "postgresHost": {
          "type": "string",
          "title": "PostgreSQL Host"
        },
        "postgresPort": {
          "type": "integer",
          "title": "PostgreSQL Port",
          "default": 5432
        },
        "postgresUser": {
          "type": "string",
          "title": "PostgreSQL User"
        },
        "postgresPassword": {
          "type": "string",
          "format": "password",
          "title": "PostgreSQL Password"
        },
        "postgresDb": {
          "type": "string",
          "title": "PostgreSQL Database"
        },
        "postgresTable": {
          "type": "string",
          "title": "PostgreSQL Table Name"
        },
        "chromaHost": {
          "type": "string",
          "title": "Chroma Host"
        },
        "chromaPort": {
          "type": "integer",
          "title": "Chroma Port",
          "default": 8000
        },
        "chromaCollection": {
          "type": "string",
          "title": "Chroma Collection Name"
        },
        "embeddingProvider": {
          "type": "string",
          "title": "Embedding Provider",
          "enum": ["openai", "azure"],
          "description": "Choose your embedding model provider"
        },
        "embeddingModel": {
          "type": "string",
          "title": "Embedding Model",
          "description": "Specify the embedding model to use"
        },
        "embeddingApiKey": {
          "type": "string",
          "format": "password",
          "title": "Embedding API Key"
        },
        "azureBaseUrl": {
          "type": "string",
          "title": "Azure Base URL",
          "format": "uri",
          "description": "Required if using Azure as embedding provider"
        },
        "azureApiVersion": {
          "type": "string",
          "title": "Azure API Version",
          "description": "e.g., 2024-02-15-preview"
        },
        "chunkingStrategy": {
          "type": "string",
          "title": "Chunking Strategy",
          "enum": ["fixed", "recursive", "sliding"],
          "description": "Strategy for splitting documents into chunks"
        },
        "maxSegmentSize": {
          "type": "integer",
          "title": "Max Segment Size",
          "description": "Maximum size of each chunk in characters"
        },
        "maxOverlapSize": {
          "type": "integer",
          "title": "Max Overlap Size",
          "description": "Overlap between chunks for context continuity"
        }
      }
    }
  }
}
